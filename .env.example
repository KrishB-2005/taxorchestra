# Copy to .env and fill in. Every value here is optional: with no keys at all
# the system runs end to end on the deterministic `fixture` LLM provider, which
# is what the test suite and `--provider fixture` benchmarks use.

# ---------------------------------------------------------------------------
# LLM provider: anthropic | bedrock | fixture
# ---------------------------------------------------------------------------
TAXORCHESTRA_LLM_PROVIDER=fixture

# Used when provider=anthropic. The SDK also resolves ANTHROPIC_AUTH_TOKEN or an
# `ant auth login` profile, so this can stay blank if you are logged in.
ANTHROPIC_API_KEY=
TAXORCHESTRA_MODEL=claude-opus-5

# Used when provider=bedrock (AnthropicBedrockMantle + the standard AWS
# credential chain). Bedrock model IDs carry an `anthropic.` prefix.
AWS_REGION=us-east-1
TAXORCHESTRA_BEDROCK_MODEL=anthropic.claude-opus-5

# ---------------------------------------------------------------------------
# Field-mapping cache: sqlite | dynamodb | memory
# Resolving all 229 Form 1040 fields costs real LLM calls; the cache is what
# turns a repeat filing into a sub-second dictionary lookup.
# ---------------------------------------------------------------------------
TAXORCHESTRA_CACHE=sqlite
TAXORCHESTRA_CACHE_PATH=.taxorchestra/mapping.cache.sqlite
TAXORCHESTRA_DYNAMO_TABLE=taxorchestra-field-mappings
